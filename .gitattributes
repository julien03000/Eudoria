# Normalize line endings: text files are stored with LF in the repository.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.glb  binary
*.fbx  binary
*.zip  binary
*.pdf  binary
