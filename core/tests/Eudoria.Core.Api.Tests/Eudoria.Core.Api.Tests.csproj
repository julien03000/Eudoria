<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Eudoria.Core.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Eudoria.Core.Api\Eudoria.Core.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public contract, copied next to the tests so they can check the core against it. -->
    <None Include="..\..\..\shared\api\core-v1.yaml" Link="Contracts\core-v1.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
