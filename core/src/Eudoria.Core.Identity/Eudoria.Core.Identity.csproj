<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Eudoria.Core.Identity</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core types (endpoints, results) without making this module a web host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="NSec.Cryptography" />
    <!-- Design-time only (dotnet-ef migrations); never shipped with the core. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Eudoria.Core.Identity.Tests" />
    <InternalsVisibleTo Include="Eudoria.Core.Api.Tests" />
  </ItemGroup>

</Project>
