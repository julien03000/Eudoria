{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Tokens": {
      "Issuer": "eudoria-core",
      "Audience": "eudoria-core",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "7.00:00:00",
      "SessionLifetime": "30.00:00:00"
    },
    "Throttling": {
      "FreeFailures": 5,
      "FirstBlock": "00:01:00",
      "MaxBlock": "00:15:00",
      "FailureMemory": "1.00:00:00",
      "IdentifierMaxFailures": 20,
      "IdentifierWindow": "00:15:00",
      "IdentifierBlock": "00:15:00",
      "MaxTrackedKeys": 100000,
      "Login": { "PermitLimit": 30, "Window": "00:01:00" },
      "Registration": { "PermitLimit": 10, "Window": "01:00:00" },
      "Refresh": { "PermitLimit": 60, "Window": "00:01:00" },
      "Account": { "PermitLimit": 30, "Window": "00:01:00" },
      "MaxConcurrentHashes": 4,
      "HashQueueTimeout": "00:00:10"
    }
  }
}
