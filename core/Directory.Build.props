<Project>
  <!-- Shared settings for every project of the core (ADR-0001). -->
  <PropertyGroup>
    <!-- Runtime: .NET 10 LTS. The SDK (11, pinned by /global.json) only builds. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Analyzer rules frozen to the .NET 10 set, so a newer SDK cannot add surprise errors. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
