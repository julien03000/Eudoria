# EUDORIA — local development settings (template).
# Copy this file to ".env" at the repository root, then change the password.
# ".env" is never committed (see .gitignore). Development only.

# --- PostgreSQL (tools/dev/docker-compose.yml) ---
POSTGRES_USER=eudoria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eudoria
# Published on 127.0.0.1 only (not reachable from the local network).
POSTGRES_PORT=5432

# --- Core (tools/dev/run-core.ps1) ---
# HTTPS only, with the .NET development certificate (trust it once: dotnet dev-certs https --trust).
CORE_HTTPS_PORT=5443

# --- Core: access-token signing key (ES256, private: never share it) ---
# Leave empty here; generate it in your .env with: .\tools\dev\new-signing-key.ps1
IDENTITY_TOKEN_SIGNING_KEY=

# --- Core: world entry ticket signing key (ES256, private, distinct from the key above; ADR-0007) ---
# Leave empty here; generate it in your .env with: .\tools\dev\new-signing-key.ps1 -EntryTickets
IDENTITY_ENTRY_TICKET_SIGNING_KEY=
