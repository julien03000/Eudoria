# =========================================================
# EUDORIA — .gitignore
# Generic rules + Unreal Engine rules (ADR-0005).
# Backend-specific rules (.NET or Go) will be added once ADR-0001 is accepted.
# =========================================================

# --- Secrets & local environment (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets/

# --- Operating systems ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
*~
.directory

# --- Editors & IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.vs/
*.swp
*.swo
*.sublime-workspace
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.suo
*.user

# --- Unreal Engine: generated files (never versioned) ---
# Applies to the project root and to every plugin.
Binaries/
Intermediate/
Saved/
DerivedDataCache/
**/Plugins/**/Binaries/
**/Plugins/**/Intermediate/
# Generated IDE project files (regenerated from the .uproject)
*.sln
*.slnx
*.xcworkspace
*.xcodeproj
.vsconfig
# Packaged builds
Build/**/*.pak
ArchivedBuilds/
Packaged/
# Crash reports & profiling captures
*.dmp
*.utrace

# --- Generic build outputs, dependencies, caches ---
# Root-only on purpose: an Unreal project has its own "Build/" folder (icons,
# platform settings) that MUST be versioned, and git on Windows ignores case.
/build/
/dist/
/out/
/tmp/
/temp/
*.tmp

# --- Logs ---
logs/
*.log

# --- Claude Code local settings (personal, not shared) ---
.claude/settings.local.json
