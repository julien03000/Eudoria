# =========================================================
# EUDORIA — .gitignore
# Generic rules + Unreal Engine rules (ADR-0005) + .NET rules (ADR-0001).
# =========================================================

# --- Secrets & local environment (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets/

# --- Operating systems ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
*~
.directory

# --- Editors & IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.vs/
*.swp
*.swo
*.sublime-workspace
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.suo
*.user

# --- Unreal Engine: generated files (never versioned) ---
# Applies to the project root and to every plugin.
Binaries/
Intermediate/
Saved/
DerivedDataCache/
**/Plugins/**/Binaries/
**/Plugins/**/Intermediate/
# Generated IDE project files (regenerated from the .uproject)
# Scoped to unreal/: the core's .NET solution (core/*.slnx) MUST be versioned.
/unreal/*.sln
/unreal/*.slnx
*.xcworkspace
*.xcodeproj
.vsconfig
# Packaged builds
Build/**/*.pak
ArchivedBuilds/
Packaged/
# Render test content (sub-step 1.7, decisions D1-D2): third-party assets and the map built
# from them stay out of the repository; tools/dev/setup-render-test.ps1 puts them back.
/unreal/Content/Characters/
/unreal/Content/Fab/
/unreal/Content/RenderTest/
# Crash reports & profiling captures
*.dmp
*.utrace

# --- Generic build outputs, dependencies, caches ---
# Root-only on purpose: an Unreal project has its own "Build/" folder (icons,
# platform settings) that MUST be versioned, and git on Windows ignores case.
/build/
/dist/
/out/
/tmp/
/temp/
*.tmp

# --- .NET (core/, ADR-0001) ---
# Capitalised "Binaries/" above is Unreal's; on Windows git ignores case, so
# these lowercase .NET folders are listed explicitly anyway.
bin/
obj/
TestResults/
*.trx
coverage*/

# --- Logs ---
logs/
*.log

# --- Claude Code local settings (personal, not shared) ---
.claude/settings.local.json
