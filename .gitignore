# =========================================================
# EUDORIA — .gitignore
# Generic rules only. Stack-specific rules (engine, backend
# language, etc.) will be added once the related ADRs are accepted.
# =========================================================

# --- Secrets & local environment (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets/

# --- Operating systems ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
*~
.directory

# --- Editors & IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.sublime-workspace

# --- Build outputs, dependencies, caches ---
build/
dist/
out/
tmp/
temp/
*.tmp

# --- Logs ---
logs/
*.log

# --- Claude Code local settings (personal, not shared) ---
.claude/settings.local.json
